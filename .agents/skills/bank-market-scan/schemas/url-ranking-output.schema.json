{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "institution_id", "run_id", "ranked_candidates", "model"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "institution_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "ranked_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "url", "priority", "role", "reason", "model_confidence"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "priority": {"type": "integer", "minimum": 0, "maximum": 3},
          "role": {"enum": ["core", "supporting", "excluded_context", "unknown"]},
          "reason": {"type": "string", "minLength": 1},
          "model_confidence": {"enum": ["low", "medium", "high"]}
        },
        "additionalProperties": false
      }
    },
    "model": {
      "type": "object",
      "required": ["provider", "model", "prompt_version"],
      "properties": {
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "prompt_version": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
