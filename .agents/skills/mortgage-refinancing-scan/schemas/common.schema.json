{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mortgage-refinancing-scan.local/1.0.0/common.schema.json",
  "title": "MortgageRefinancingScanCommon",
  "description": "Shared scalars, identifiers and enums for the mortgage-refinancing-scan run contracts.",
  "$defs": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9]{8}T[0-9]{6}Z-[a-z0-9]{6,}$"
    },
    "entry_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "institution_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "institution_type": {
      "type": "string",
      "enum": ["cooperative_bank"]
    },
    "lp": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "https_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://[^\\s<>]+$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^<>]+$"
    },
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "byte_count": {
      "type": "integer",
      "minimum": 0
    },
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z]{2,8}-[0-9a-f]{24}$"
    },
    "artifact_id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact_id"}
    },
    "source_artifact_id": {
      "type": "string",
      "pattern": "^src-[0-9a-f]{24}$"
    },
    "source_artifact_id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/source_artifact_id"}
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^ev-[0-9a-f]{24}$"
    },
    "product_id": {
      "type": "string",
      "pattern": "^prd-[0-9a-f]{24}$"
    },
    "variant_id": {
      "type": "string",
      "pattern": "^var-[0-9a-f]{24}$"
    },
    "opaque_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "run_state": {
      "type": "string",
      "enum": [
        "CREATED",
        "PREPARED",
        "RUNNING",
        "READY",
        "FINALIZING",
        "FINALIZED",
        "ABORTED"
      ]
    },
    "entry_stage": {
      "type": "string",
      "enum": [
        "discovery",
        "fetched",
        "normalized",
        "evidence_ready",
        "interpreted",
        "technical_error"
      ]
    },
    "decision_status": {
      "type": "string",
      "enum": [
        "qualified",
        "explicitly_not_qualified",
        "unconfirmed",
        "technical_error"
      ]
    },
    "business_decision_status": {
      "type": "string",
      "enum": [
        "qualified",
        "explicitly_not_qualified",
        "unconfirmed"
      ]
    },
    "entry_outcome": {
      "type": "string",
      "enum": ["business_decision", "external_source_error", "internal_error"]
    },
    "criterion_key": {
      "type": "string",
      "enum": ["housing", "refinancing", "fixed_rate"]
    },
    "criterion_status": {
      "type": "string",
      "enum": ["found", "not_found", "ambiguous"]
    },
    "criterion_status_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["housing", "refinancing", "fixed_rate"],
      "properties": {
        "housing": {"$ref": "#/$defs/criterion_status"},
        "refinancing": {"$ref": "#/$defs/criterion_status"},
        "fixed_rate": {"$ref": "#/$defs/criterion_status"}
      }
    },
    "rate_type": {
      "type": "string",
      "enum": ["permanent_fixed", "periodically_fixed"]
    },
    "source_type": {
      "type": "string",
      "enum": [
        "official_product_page",
        "official_tariff",
        "official_pdf",
        "official_form",
        "official_registry"
      ]
    },
    "field_path": {
      "type": "string",
      "pattern": "^(qualification\\.(housing|refinancing|fixed_rate)|offer\\.[a-z0-9_]+)$"
    },
    "field_status": {
      "type": "string",
      "enum": ["found", "not_found", "ambiguous", "not_applicable"]
    },
    "field_status_map": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/field_path"},
      "additionalProperties": {"$ref": "#/$defs/field_status"}
    },
    "field_evidence_map": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/field_path"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"$ref": "#/$defs/evidence_id"}
      }
    },
    "decision_reason_code": {
      "type": "string",
      "enum": [
        "housing_or_mortgage_loan_confirmed",
        "refinance_or_repayment_of_previous_housing_mortgage_loan_confirmed",
        "fixed_rate_confirmed",
        "no_housing_or_mortgage_loan_confirmed",
        "no_refinance_or_repayment_confirmed",
        "no_fixed_rate_confirmed",
        "only_variable_rate_found",
        "only_refinancing_of_own_costs_found",
        "ambiguous_sources"
      ]
    },
    "entry_run_error_code": {
      "type": "string",
      "enum": [
        "required_source_unavailable",
        "request_timeout_after_retries",
        "robots_denied",
        "official_host_violation",
        "evidence_mismatch"
      ]
    },
    "fatal_run_error_code": {
      "type": "string",
      "enum": [
        "schema_mismatch",
        "dependency_missing",
        "publication_io_failure"
      ]
    },
    "checkpoint_status": {
      "type": "string",
      "enum": ["ready", "ready_with_errors"]
    },
    "coverage_status": {
      "type": "string",
      "enum": ["complete", "degraded"]
    },
    "publication_status": {
      "type": "string",
      "enum": ["published"]
    },
    "cache_status": {
      "type": "string",
      "enum": ["miss", "revalidated", "refetched"]
    },
    "transport_cache_policy": {
      "type": "string",
      "enum": ["revalidate_conditional"]
    },
    "normalization_version": {
      "type": "string",
      "pattern": "^morfeusz-2:[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "scope_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "lp", "institution_id", "institution_type"],
      "properties": {
        "entry_id": {"$ref": "#/$defs/entry_id"},
        "lp": {"$ref": "#/$defs/lp"},
        "institution_id": {"$ref": "#/$defs/institution_id"},
        "institution_type": {"$ref": "#/$defs/institution_type"}
      }
    },
    "scope_entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/scope_entry"}
    },
    "validation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["passed", "failed"]
        },
        "errors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "if": {
        "properties": {"status": {"const": "failed"}},
        "required": ["status"]
      },
      "then": {
        "type": "object",
        "required": ["status", "errors"],
        "properties": {"errors": {"type": "array", "minItems": 1}}
      }
    }
  }
}
