{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mortgage-refinancing-scan.local/1.0.0/institution-registry-snapshot.schema.json",
  "title": "InstitutionRegistrySnapshot",
  "description": "Immutable BFG/KNF registry input copied into one run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "source_kind", "observed_at", "entries"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "snapshot_id": {"$ref": "common.schema.json#/$defs/opaque_id"},
    "source_kind": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._:-]+$"},
    "observed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "lp",
          "institution_id",
          "institution_type",
          "legal_name",
          "official_hosts",
          "allowed_redirect_hosts",
          "registry_sources",
          "observed_at"
        ],
        "properties": {
          "entry_id": {"$ref": "common.schema.json#/$defs/entry_id"},
          "lp": {"$ref": "common.schema.json#/$defs/lp"},
          "institution_id": {"$ref": "common.schema.json#/$defs/institution_id"},
          "institution_type": {"$ref": "common.schema.json#/$defs/institution_type"},
          "legal_name": {"type": "string", "minLength": 1, "maxLength": 256},
          "official_hosts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$", "maxLength": 253}
          },
          "allowed_redirect_hosts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$", "maxLength": 253}
          },
          "registry_sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._:-]+$"}
          },
          "observed_at": {"$ref": "common.schema.json#/$defs/timestamp"}
        }
      }
    }
  }
}
